# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000

# SQLite database file (created automatically)
DATABASE_PATH=./data/rutabanks.db

# Set to 1 when running behind a reverse proxy (Render, Railway, Nginx)
TRUST_PROXY=0

# Form submissions allowed per visitor every 15 minutes
FORM_RATE_LIMIT=10

# Email (SMTP). Leave SMTP_HOST empty to print emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rutabanks Website <no-reply@rutabanks.rw>"
# Address that receives new message and appointment notifications
FIRM_EMAIL=rutayisireeugene1968@gmail.com
