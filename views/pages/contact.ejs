<%- include('../partials/head', { title: "Contact Us – Rutabanks Notary and Legal Services Ltd", description: "Contact Rutabanks Notary and Legal Services Ltd in Kigali, Rwanda. Book an appointment or send us a message.", activePage: 'contact' }) %>
<%- include('../partials/navbar', { activePage: 'contact' }) %>

  <!-- PAGE HERO -->
  <header class="page-hero" aria-labelledby="contact-page-title">
    <div class="container">
      <div class="page-hero-content">
        <span class="section-label">Get In Touch</span>
        <h1 id="contact-page-title">Contact Us</h1>
        <p>We are ready to assist you with all your legal and notarial needs. Reach out today to get started.</p>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">Contact</span>
        </nav>
      </div>
    </div>
  </header>

  <!-- CONTACT SECTION -->
  <section class="section" aria-labelledby="contact-heading">
    <div class="container">
      <div class="contact-grid">

        <!-- INFO COLUMN -->
        <div class="contact-info" aria-label="Contact information">
          <div class="section-header" style="text-align:left; margin-bottom:32px;">
            <span class="section-label">How to Reach Us</span>
            <h2 id="contact-heading" style="font-size:1.8rem;">We Are Here for You</h2>
            <p style="margin:0;">Whether you need legal advice, document notarization, or want to book an appointment, we make it easy to connect.</p>
            <div class="divider" style="margin-left:0;" aria-hidden="true"></div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">📍</div>
            <div>
              <h4>Office Location</h4>
              <p>Kigali, Rwanda</p>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">📞</div>
            <div>
              <h4>Phone Number</h4>
              <p><a href="tel:0788308526">0788308526</a></p>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">📧</div>
            <div>
              <h4>Email Address</h4>
              <p><a href="mailto:rutayisireeugene1968@gmail.com">rutayisireeugene1968@gmail.com</a></p>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-icon" aria-hidden="true">🕒</div>
            <div>
              <h4>Working Hours</h4>
              <div class="hours-grid">
                <div class="hours-item">
                  <strong>Monday – Friday</strong>
                  8:00 AM – 6:00 PM
                </div>
                <div class="hours-item">
                  <strong>Saturday</strong>
                  9:00 AM – 2:00 PM
                </div>
                <div class="hours-item">
                  <strong>Sunday</strong>
                  Closed
                </div>
              </div>
            </div>
          </div>

          <div class="disclaimer-box" role="note" aria-label="Legal notice">
            <h5>⚖️ Legal Notice</h5>
            <p>Contacting us does not create a lawyer-client relationship. All information shared is for initial inquiry purposes only. See our full <a href="/disclaimer" style="color:var(--dark-blue); font-weight:600;">Legal Disclaimer</a>.</p>
          </div>
        </div>

        <!-- FORMS COLUMN -->
        <div>
          <!-- CONTACT FORM -->
          <div class="contact-form-card" style="margin-bottom:40px;" aria-labelledby="contact-form-heading">
            <h3 id="contact-form-heading">Send Us a Message</h3>
            <p>Fill in the form below and we will get back to you as soon as possible.</p>
            <form id="contactForm" novalidate aria-label="Contact form">
              <div class="form-row">
                <div class="form-group">
                  <label for="first-name">First Name <span aria-hidden="true" style="color:red;">*</span></label>
                  <input type="text" id="first-name" name="first_name" required placeholder="Jean" autocomplete="given-name" />
                </div>
                <div class="form-group">
                  <label for="last-name">Last Name <span aria-hidden="true" style="color:red;">*</span></label>
                  <input type="text" id="last-name" name="last_name" required placeholder="Mutabazi" autocomplete="family-name" />
                </div>
              </div>
              <div class="form-group">
                <label for="email">Email Address <span aria-hidden="true" style="color:red;">*</span></label>
                <input type="email" id="email" name="email" required placeholder="jean.mutabazi@example.com" autocomplete="email" />
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="+250 7XX XXX XXX" autocomplete="tel" />
              </div>
              <div class="form-group">
                <label for="service-inquiry">Service of Interest</label>
                <select id="service-inquiry" name="service_inquiry">
                  <option value="" disabled selected>Select a service...</option>
                  <option value="notarial">Notarial Services</option>
                  <option value="legal-advisory">Legal Consultation &amp; Advisory</option>
                  <option value="contract">Contract Drafting &amp; Review</option>
                  <option value="company-reg">Company Registration</option>
                  <option value="property">Property &amp; Land Transaction</option>
                  <option value="power-of-attorney">Power of Attorney</option>
                  <option value="due-diligence">Legal Due Diligence</option>
                  <option value="court-docs">Court Document Preparation</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Your Message <span aria-hidden="true" style="color:red;">*</span></label>
                <textarea id="message" name="message" required placeholder="Please describe your legal need or question..."></textarea>
              </div>
              <button type="submit" class="btn btn-primary form-submit">✉️ Send Message</button>
              <p class="form-note">🔒 Your information is confidential and will not be shared with third parties.</p>
            </form>
          </div>

          <!-- APPOINTMENT FORM -->
          <div class="contact-form-card" id="appointment" aria-labelledby="appointment-form-heading">
            <h3 id="appointment-form-heading">📅 Book an Appointment</h3>
            <p>Prefer to meet in person? Schedule an appointment at our Kigali office.</p>
            <form id="appointmentForm" novalidate aria-label="Appointment booking form">
              <div class="form-row">
                <div class="form-group">
                  <label for="appt-name">Full Name <span aria-hidden="true" style="color:red;">*</span></label>
                  <input type="text" id="appt-name" name="full_name" required placeholder="Your full name" autocomplete="name" />
                </div>
                <div class="form-group">
                  <label for="appt-phone">Phone Number <span aria-hidden="true" style="color:red;">*</span></label>
                  <input type="tel" id="appt-phone" name="phone" required placeholder="+250 7XX XXX XXX" autocomplete="tel" />
                </div>
              </div>
              <div class="form-group">
                <label for="appt-email">Email Address</label>
                <input type="email" id="appt-email" name="email" placeholder="your@email.com" autocomplete="email" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="appt-date">Preferred Date <span aria-hidden="true" style="color:red;">*</span></label>
                  <input type="date" id="appt-date" name="date" required min="" />
                </div>
                <div class="form-group">
                  <label for="appt-time">Preferred Time</label>
                  <select id="appt-time" name="time">
                    <option value="" disabled selected>Select time...</option>
                    <option value="08:00">8:00 AM</option>
                    <option value="09:00">9:00 AM</option>
                    <option value="10:00">10:00 AM</option>
                    <option value="11:00">11:00 AM</option>
                    <option value="12:00">12:00 PM</option>
                    <option value="14:00">2:00 PM</option>
                    <option value="15:00">3:00 PM</option>
                    <option value="16:00">4:00 PM</option>
                    <option value="17:00">5:00 PM</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label for="appt-service">Service Required <span aria-hidden="true" style="color:red;">*</span></label>
                <select id="appt-service" name="service" required>
                  <option value="" disabled selected>Select a service...</option>
                  <option value="notarial">Notarial Services</option>
                  <option value="legal-advisory">Legal Consultation &amp; Advisory</option>
                  <option value="contract">Contract Drafting &amp; Review</option>
                  <option value="company-reg">Company Registration</option>
                  <option value="property">Property &amp; Land Transaction</option>
                  <option value="power-of-attorney">Power of Attorney</option>
                  <option value="due-diligence">Legal Due Diligence</option>
                  <option value="court-docs">Court Document Preparation</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label for="appt-notes">Additional Notes</label>
                <textarea id="appt-notes" name="notes" placeholder="Any details that will help us prepare for your appointment..." style="min-height:100px;"></textarea>
              </div>
              <button type="submit" class="btn btn-primary form-submit">📅 Confirm Appointment Request</button>
              <p class="form-note">📞 We will call to confirm your appointment within one business day.</p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

<%- include('../partials/footer', { activePage: 'contact' }) %>
  <script>
    // Set min date for appointment to tomorrow
    const dateInput = document.getElementById('appt-date');
    if (dateInput) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      dateInput.min = tomorrow.toISOString().split('T')[0];
    }
  </script>
</body>
</html>
