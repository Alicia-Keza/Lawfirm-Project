<%- include('partials/head', { title: 'Overview' }) %>
<%- include('partials/header', { section: 'overview' }) %>
<main class="admin-container admin-main">
  <h1>Welcome, <%= admin.name %></h1>
  <div class="admin-stats">
    <a class="admin-card admin-stat" href="/admin/appointments?status=pending">
      <span class="admin-stat-num"><%= counts.pendingAppointments %></span>
      <span class="admin-stat-label">Appointments waiting for confirmation</span>
    </a>
    <a class="admin-card admin-stat" href="/admin/messages?view=new">
      <span class="admin-stat-num"><%= counts.newMessages %></span>
      <span class="admin-stat-label">New messages</span>
    </a>
  </div>
</main>
</body>
</html>
