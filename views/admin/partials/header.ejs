  <header class="admin-header">
    <div class="admin-container admin-header-inner">
      <a href="/admin" class="admin-brand">⚖️ Rutabanks Admin</a>
      <nav class="admin-nav" aria-label="Admin navigation">
        <a href="/admin"<% if (section === 'overview') { %> aria-current="page"<% } %>>Overview</a>
        <a href="/admin/appointments"<% if (section === 'appointments') { %> aria-current="page"<% } %>>Appointments</a>
        <a href="/admin/messages"<% if (section === 'messages') { %> aria-current="page"<% } %>>Messages</a>
      </nav>
      <form method="post" action="/admin/logout" class="admin-logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <span class="admin-user"><%= admin.name %></span>
        <button type="submit" class="admin-btn admin-btn-light">Sign out</button>
      </form>
    </div>
  </header>
