<%- include('partials/head', { title: 'Sign in' }) %>
<main class="admin-login">
  <div class="admin-card admin-login-card">
    <p class="admin-brand admin-brand-dark">⚖️ Rutabanks Admin</p>
    <h1>Sign in</h1>
    <% if (error) { %>
    <p class="admin-alert" role="alert"><%= error %></p>
    <% } %>
    <form method="post" action="/admin/login">
      <input type="hidden" name="next" value="<%= next %>" />
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= email %>" required autocomplete="username" autofocus />
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>
      <button type="submit" class="btn btn-primary form-submit">Sign in</button>
    </form>
    <p class="admin-muted"><a href="/">← Back to the website</a></p>
  </div>
</main>
</body>
</html>
